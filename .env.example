# Template only. Generate private values in a git-ignored .env file; never commit real credentials.
JEEVAN_API_KEY=replace-with-a-long-random-secret
POSTGRES_USER=jeevan
POSTGRES_PASSWORD=replace-this-local-development-password
POSTGRES_DB=jeevan
JEEVAN_HOST_IP=127.0.0.1
JEEVAN_HOST_PORT=8080
IDENTITY_PROVIDER_MODE=demo
IDENTITY_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# =====================================================================
# REAL SMS PROVIDER CONFIGURATION (For Donor Mobile Phone OTP)
# =====================================================================
# Supported providers:
#   - fast2sms  : India's instant transactional OTP SMS (Easiest & quickest setup in India)
#   - msg91     : Enterprise DLT OTP SMS provider (India)
#   - twofactor : 2Factor.in dedicated OTP SMS provider (India)
#   - twilio    : Twilio Global Programmable SMS
#
# Choose your active provider below:
SMS_PROVIDER=fast2sms

# ---------------------------------------------------------------------
# Option 1: Fast2SMS (Recommended for India - Quickest Setup)
# Register at https://www.fast2sms.com -> Dev API -> Copy API Key
# ---------------------------------------------------------------------
SMS_PROVIDER_API_KEY=your_fast2sms_api_authorization_key_here
# Optional if using DLT template route:
# SMS_SENDER_ID=FSTSMS
# SMS_TEMPLATE_ID=123456

# ---------------------------------------------------------------------
# Option 2: MSG91 (Enterprise DLT in India)
# Register at https://msg91.com -> AuthKey & DLT Template ID
# ---------------------------------------------------------------------
# SMS_PROVIDER=msg91
# SMS_PROVIDER_API_KEY=your_msg91_authkey_here
# SMS_TEMPLATE_ID=your_msg91_otp_flow_or_template_id
# SMS_SENDER_ID=JEEVAN

# ---------------------------------------------------------------------
# Option 3: 2Factor.in (India OTP Service)
# Register at https://2factor.in -> API Key
# ---------------------------------------------------------------------
# SMS_PROVIDER=twofactor
# SMS_PROVIDER_API_KEY=your_2factor_api_key_here
# SMS_TEMPLATE_ID=your_dlt_template_name_if_any

# ---------------------------------------------------------------------
# Option 4: Twilio (Global SMS)
# Register at https://www.twilio.com -> Console
# ---------------------------------------------------------------------
# SMS_PROVIDER=twilio
# SMS_PROVIDER_API_KEY=your_twilio_account_sid
# SMS_PROVIDER_SECRET=your_twilio_auth_token
# SMS_SENDER_ID=+1234567890
